# Copy to infra/.env and fill in, then `npm run deploy` from the repo root.

# Short app name — used for the stack + resource names (letters/numbers/dashes).
APP_NAME=myapp

# First admin account, seeded on deploy.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-something-strong

# Optional custom domain (leave blank to use the CloudFront URL).
# Requires a Route 53 hosted zone in this account; deploy in us-east-1.
DOMAIN_NAME=
INCLUDE_WWW=false

# Region (must be us-east-1 if using a custom domain).
CDK_DEFAULT_REGION=us-east-1
