# Copy to infra/.env and fill in, then `npm run deploy` from the repo root.

# Short app name — used for the stack + resource names (letters/numbers/dashes).
APP_NAME=myapp

# First admin account, seeded on deploy.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-something-strong

# Region (must be us-east-1 if using a custom domain in cloudfront mode).
CDK_DEFAULT_REGION=us-east-1

# ---- Optional modules ----
# Provision the WebSocket API + connections table + handlers.
ENABLE_WEBSOCKET=false

# ---- Hosting ----
# "cloudfront": app gets its own S3 + CloudFront (+ optional custom domain).
# "existing-bucket": deploy the SPA into an existing site bucket under a path.
HOSTING_MODE=cloudfront

# cloudfront mode (optional custom domain; needs a Route 53 hosted zone):
DOMAIN_NAME=
INCLUDE_WWW=false

# existing-bucket mode:
SITE_BUCKET_NAME=
SITE_PATH_PREFIX=myapp
SITE_BASE_URL=
